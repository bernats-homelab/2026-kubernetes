{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["repoURL", "targetRevision", "tailscaleOperator", "nasStorage", "apps", "smokeApp", "charts"],
  "definitions": {
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoURL", "chart", "version"],
      "properties": {
        "repoURL": { "type": "string", "pattern": "^(https|oci)://" },
        "chart": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "dnsLabel": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" },
    "appRepoURL": { "type": "string", "pattern": "^https://github\\.com/bernats-homelab/[A-Za-z0-9._-]+$" },
    "appRevision": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoURL", "targetRevision"],
      "properties": {
        "repoURL": { "$ref": "#/definitions/appRepoURL" },
        "targetRevision": { "$ref": "#/definitions/appRevision" },
        "namespace": { "$ref": "#/definitions/dnsLabel" },
        "syncWave": { "type": "string", "pattern": "^-?[0-9]+$" }
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "repoURL": { "type": "string", "pattern": "^https://github\\.com/" },
    "targetRevision": { "type": "string", "minLength": 1 },
    "tailscaleOperator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "nasStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "apps": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          { "$ref": "#/definitions/dnsLabel" },
          {
            "not": {
              "enum": ["root", "argocd", "tailscale-operator", "hello-world", "cloudnative-pg", "immich-database", "immich", "obsidian", "k8s-app-smoke"]
            }
          }
        ]
      },
      "additionalProperties": { "$ref": "#/definitions/app" }
    },
    "smokeApp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "repoURL", "targetRevision"],
      "properties": {
        "enabled": { "type": "boolean" },
        "repoURL": { "$ref": "#/definitions/appRepoURL" },
        "targetRevision": { "$ref": "#/definitions/appRevision" }
      }
    },
    "charts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argocd", "tailscaleOperator", "cloudnativePg", "immich"],
      "properties": {
        "argocd": { "$ref": "#/definitions/chart" },
        "tailscaleOperator": { "$ref": "#/definitions/chart" },
        "cloudnativePg": { "$ref": "#/definitions/chart" },
        "immich": { "$ref": "#/definitions/chart" }
      }
    }
  }
}
