{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["repoURL", "targetRevision", "tailscaleOperator", "charts"],
  "definitions": {
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoURL", "chart", "version"],
      "properties": {
        "repoURL": { "type": "string", "pattern": "^https://" },
        "chart": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "repoURL": { "type": "string", "pattern": "^https://github\\.com/" },
    "targetRevision": { "type": "string", "minLength": 1 },
    "tailscaleOperator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "charts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argocd", "tailscaleOperator"],
      "properties": {
        "argocd": { "$ref": "#/definitions/chart" },
        "tailscaleOperator": { "$ref": "#/definitions/chart" }
      }
    }
  }
}
